[build]
builder = "nixpacks"

[deploy]
startCommand = "python multi_app_server.py"
healthcheckPath = "/health"
healthcheckTimeout = 300
restartPolicyType = "on_failure"

[environments.production]
variables = { 
  NODE_ENV = "production",
  VITE_API_URL = "https://${{RAILWAY_STATIC_URL}}/api",
  PORT = "${{PORT}}"
}